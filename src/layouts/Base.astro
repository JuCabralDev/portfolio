---
import '../styles/global.css';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import SiteHeader from '../components/SiteHeader.astro';
import NetworkBackground from '../components/NetworkBackground.astro';
import { profile } from '../data/profile';
import { content } from '../data/content';
import { languages, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Páginas fora do índice (404) não recebem canonical nem alternates. */
  noindex?: boolean;
  /** Mostra a tela de boot (BootScreen) na primeira visita da sessão. */
  boot?: boolean;
}

const { lang, title, description, noindex = false, boot = false } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ?? t('meta.title');
const pageDescription = description ?? t('meta.description');

const canonical = getAbsoluteLocaleUrl(lang);
const alternates = (Object.keys(languages) as Lang[]).map((l) => ({
  hreflang: l === 'pt' ? 'pt-BR' : 'en',
  href: getAbsoluteLocaleUrl(l),
}));
const ogImage = new URL(`/og-${lang}.png`, Astro.site).href;

// Dados estruturados (schema.org/Person) para buscadores.
const personJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: content[lang].headline,
  url: canonical,
  image: new URL('/avatar-512.jpg', Astro.site).href,
  address: { '@type': 'PostalAddress', addressLocality: 'Natal', addressRegion: 'RN', addressCountry: 'BR' },
  sameAs: [profile.linkedin, profile.github],
  knowsAbout: ['Java', 'Spring Boot', 'SQL', 'PostgreSQL'],
});
---

<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en'} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#1a1310" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonical} />
          {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
          <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('pt')} />
          <script type="application/ld+json" set:html={personJsonLd} />
        </>
      )
    }

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'pt' ? 'en_US' : 'pt_BR'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}, ${content[lang].headline}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Antes da pintura: aplica o tema salvo (escuro é o padrão) e decide se a tela de boot aparece. -->
    <script is:inline data-boot={boot ? '1' : '0'}>
      (function () {
        var theme = 'dark';
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') theme = saved;
        } catch (e) {}
        document.documentElement.dataset.theme = theme;
        document.documentElement.classList.add('js');
        try {
          var wantsBoot = document.currentScript && document.currentScript.dataset.boot === '1';
          var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (wantsBoot && !reduced && sessionStorage.getItem('jc.booted') !== '1') {
            document.documentElement.classList.add('booting');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="antialiased">
    <NetworkBackground />
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-accent focus:px-3 focus:py-2 focus:text-accent-ink"
    >
      {t('a11y.skip')}
    </a>
    <SiteHeader lang={lang} />
    <main id="conteudo" class="mx-auto w-full max-w-6xl px-4 sm:px-8">
      <slot />
    </main>
    <footer class="mx-auto w-full max-w-6xl px-4 py-12 text-sm text-muted sm:px-8">
      <a href="https://github.com/JuCabralDev/portfolio">{t('footer.source')}</a>
    </footer>
  </body>
</html>
