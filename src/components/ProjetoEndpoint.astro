---
/**
 * Um projeto apresentado como resposta de API: rota, status HTTP (metáfora do estado do projeto),
 * cabeçalhos com stack/tipo/código e, no corpo, decisões técnicas, diagrama e trechos de código.
 */
import { Code } from 'astro:components';
import type { CollectionEntry } from 'astro:content';
import DiagramaEstoque from './diagramas/DiagramaEstoque.astro';
import DiagramaDindin from './diagramas/DiagramaDindin.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  projeto: CollectionEntry<'projetos'>;
}

const { projeto } = Astro.props;
const p = projeto.data;
const lang: Lang = p.lang;

const snippetFiles = import.meta.glob<string>('../snippets/*.java', { query: '?raw', import: 'default', eager: true });
const snippetCode = (file: string): string => {
  const code = snippetFiles[`../snippets/${file}.java`];
  if (code === undefined) throw new Error(`Trecho não encontrado: src/snippets/${file}.java (${p.route}, ${lang})`);
  return code.trimEnd();
};

const L = {
  pt: { type: 'X-Tipo', source: 'X-Codigo', decisions: 'decisões técnicas', limits: 'limitações e próximos passos', code: 'trechos de código', diagram: 'arquitetura' },
  en: { type: 'X-Type', source: 'X-Source', decisions: 'technical decisions', limits: 'limitations and next steps', code: 'code excerpts', diagram: 'architecture' },
}[lang];

/** Divide um texto em pedaços normais e `código`, para renderizar crases como <code>. */
const inline = (text: string) =>
  text.split(/(`[^`]+`)/g).filter(Boolean).map((part) =>
    part.startsWith('`') ? { code: true, text: part.slice(1, -1) } : { code: false, text: part },
  );
const hasAside = Boolean(p.diagram);
---

<article id={`projeto-${p.route}`} aria-labelledby={`projeto-${p.route}-titulo`} class="projeto border-b border-line py-14 first:pt-0 last:border-b-0 last:pb-0">
  <div class="font-mono text-xs leading-relaxed [font-stretch:87.5%] sm:text-[0.8rem]">
    <p><span class="text-accent">GET</span> /projetos/{p.route}</p>
    <p>
      <span class="text-muted">HTTP/1.1 </span><span class="text-ok">{p.status.code} {p.status.text}</span>
      <span class="text-muted"> ({p.status.note})</span>
    </p>
    <dl class="text-muted">
      <div class="flex gap-2"><dt class="shrink-0">X-Stack:</dt><dd class="text-text">{p.stack.join(', ')}</dd></div>
      <div class="flex gap-2"><dt class="shrink-0">{L.type}:</dt><dd class="text-text">{p.clientName ? `${p.kind} (${p.clientName})` : p.kind}</dd></div>
      <div class="flex gap-2">
        <dt class="shrink-0">{L.source}:</dt>
        <dd class="text-text">{p.source.url ? <a href={p.source.url}>{p.source.url.replace('https://', '')}</a> : p.source.label}</dd>
      </div>
    </dl>
  </div>

  <h3 id={`projeto-${p.route}-titulo`} class="mt-8 max-w-[30ch] text-2xl leading-tight font-semibold sm:text-3xl">{p.title}</h3>
  <p class="mt-4 max-w-[65ch] text-lg text-muted">{p.summary}</p>

  <div class={`mt-10 grid gap-12 ${hasAside ? 'lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]' : ''}`}>
    <div class="max-w-[65ch] min-w-0">
      <h4 class="font-mono text-sm text-accent [font-stretch:87.5%]">{L.decisions}</h4>
      <ul class="mt-4 list-disc space-y-3 pl-5 marker:text-line">
        {p.decisions.map((d) => <li>{inline(d).map((seg) => (seg.code ? <code class="inline-code">{seg.text}</code> : seg.text))}</li>)}
      </ul>

      {
        p.limits.length > 0 && (
          <>
            <h4 class="mt-10 font-mono text-sm text-accent [font-stretch:87.5%]">{L.limits}</h4>
            <ul class="mt-4 list-disc space-y-3 pl-5 text-muted marker:text-line">
              {p.limits.map((l) => <li>{inline(l).map((seg) => (seg.code ? <code class="inline-code">{seg.text}</code> : seg.text))}</li>)}
            </ul>
          </>
        )
      }
    </div>

    {
      hasAside && (
        <figure class="min-w-0 lg:sticky lg:top-24 lg:self-start">
          <figcaption class="mb-3 font-mono text-sm text-accent [font-stretch:87.5%]">{L.diagram}</figcaption>
          <div class="mx-auto max-w-[420px]">
            {p.diagram === 'estoque' && <DiagramaEstoque lang={lang} />}
            {p.diagram === 'dindin' && <DiagramaDindin lang={lang} />}
          </div>
        </figure>
      )
    }
  </div>

  {
    p.snippets.length > 0 && (
      <div class="mt-12">
        <h4 class="font-mono text-sm text-accent [font-stretch:87.5%]">{L.code}</h4>
        <div class="mt-4 space-y-8">
          {p.snippets.map((s) => (
            <figure class="min-w-0">
              <figcaption class="mb-3 max-w-[65ch]">
                <span class="font-mono text-xs text-muted [font-stretch:87.5%]">{s.title}</span>
                <span class="mt-1 block">{s.caption}</span>
              </figcaption>
              <Code code={snippetCode(s.file)} lang="java" theme="css-variables" class="snippet" />
            </figure>
          ))}
        </div>
      </div>
    )
  }
</article>

<style>
  .inline-code {
    font-family: var(--font-mono);
    font-stretch: 87.5%;
    font-size: 0.82em;
    padding: 0.1em 0.35em;
    border-radius: 3px;
    background: var(--surface);
    border: 1px solid var(--line);
    overflow-wrap: anywhere;
  }
  .projeto :global(pre.snippet) {
    background: var(--surface) !important;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    padding: 1.1rem 1.25rem;
    font-size: 0.72rem;
    line-height: 1.7;
    font-stretch: 87.5%;
    overflow-x: auto;
  }
  .projeto :global(pre.snippet code) {
    font-family: var(--font-mono);
  }
</style>
