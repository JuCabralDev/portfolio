---
import Base from '../layouts/Base.astro';
import Section from './Section.astro';
import Hero from './Hero.astro';
import BootScreen from './BootScreen.astro';
import ProjetoEndpoint from './ProjetoEndpoint.astro';
import TechTag from './TechTag.astro';
import { getCollection } from 'astro:content';
import { content } from '../data/content';
import { profile } from '../data/profile';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const c = content[lang];
const projetos = (await getCollection('projetos', (e) => e.data.lang === lang)).sort((a, b) => a.data.order - b.data.order);

const contactLinks = [
  { label: c.contact.email, href: `mailto:${profile.email}`, text: profile.email },
  { label: c.contact.linkedin, href: profile.linkedin, text: 'in/jucabraldev' },
  { label: c.contact.github, href: profile.github, text: 'JuCabralDev' },
  { label: c.contact.cv, href: profile.cv, text: 'cv-julia-cabral.pdf', download: true },
];
---

<Base lang={lang} boot>
  <BootScreen lang={lang} projectCount={projetos.length} />
  <Hero lang={lang} c={c} />

  <Section id="sobre" route={t('nav.sobre')}>
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]">
      <div class="max-w-[65ch] space-y-4">
        {c.about.map((p) => <p>{p}</p>)}
      </div>

      <div>
        <h3 class="font-mono text-xs text-accent [font-stretch:87.5%]">{c.languages.title}</h3>
        <dl class="mt-4 max-w-sm border-t border-line text-[0.94rem]">
          {
            c.languages.items.map(({ name, level }) => (
              <div class="flex items-baseline justify-between gap-4 border-b border-line py-2.5">
                <dt>{name}</dt>
                <dd class="font-mono text-xs text-muted [font-stretch:87.5%]">{level}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </Section>

  <Section id="stack" route={t('nav.stack')}>
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]">
      <dl class="grid gap-x-8 gap-y-5 sm:grid-cols-[7.5rem_1fr]">
        {
          c.stack.map(({ group, items }) => (
            <>
              <dt class="pt-0.5 font-mono text-xs text-muted [font-stretch:87.5%]">{group}</dt>
              <dd class="-mt-3 flex flex-wrap gap-x-5 gap-y-2 text-[0.94rem] sm:m-0">
                {items.map((name) => (
                  <TechTag name={name} />
                ))}
              </dd>
            </>
          ))
        }
      </dl>

      <div>
        <h3 class="font-mono text-xs text-accent [font-stretch:87.5%]">{c.studying.title}</h3>
        <ul class="mt-4 space-y-4 text-[0.94rem]">
          {
            c.studying.items.map(({ name, why }) => (
              <li>
                <p class="font-medium">{name}</p>
                <p class="text-muted">{why}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <Section id="projetos" route={t('nav.projetos')}>
    {projetos.map((projeto) => <ProjetoEndpoint projeto={projeto} />)}
  </Section>

  <Section id="experiencia" route={t('nav.experiencia')}>
    <ol class="max-w-[70ch] border-l border-line">
      {
        c.experience.map((job) => (
          <li class="relative pb-10 pl-6 last:pb-0 sm:pl-8">
            <span class="absolute top-1.5 -left-[5px] size-[9px] rounded-full border border-accent bg-bg" aria-hidden="true" />
            <p class="font-mono text-xs text-muted [font-stretch:87.5%]">
              <time datetime={job.start}>{job.period}</time>
            </p>
            <h3 class="mt-1 text-lg font-semibold">{job.role}</h3>
            <p class="text-muted">{job.org}</p>
            <ul class="mt-3 list-disc space-y-1.5 pl-5 text-[0.94rem] marker:text-line">
              {job.bullets.map((b) => <li>{b}</li>)}
            </ul>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="formacao" route={t('nav.formacao')}>
    <ul class="max-w-[70ch] space-y-6">
      {
        c.education.map((e) => (
          <li>
            <p class="font-mono text-xs text-muted [font-stretch:87.5%]">{e.period}</p>
            <h3 class="mt-1 text-lg font-semibold">{e.course}</h3>
            <p class="text-muted">{e.school}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="contato" route={t('nav.contato')} method="POST">
    <p class="max-w-[50ch]">{c.contact.lead}</p>
    <dl class="mt-8 grid max-w-2xl gap-x-8 gap-y-3 sm:grid-cols-[7.5rem_1fr]">
      {
        contactLinks.map((l) => (
          <>
            <dt class="font-mono text-xs text-muted [font-stretch:87.5%] sm:pt-1">{l.label}</dt>
            <dd class="-mt-2 mb-3 min-w-0 sm:m-0">
              <a href={l.href} download={l.download} class="font-medium break-words underline">
                {l.text}
              </a>
            </dd>
          </>
        ))
      }
    </dl>
  </Section>
</Base>
