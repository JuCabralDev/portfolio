---
/**
 * Seção da página única. O título é a própria rota da seção (GET /projetos),
 * e o mesmo slug é a âncora usada pela navegação.
 */
interface Props {
  id: string;
  route: string;
  method?: string;
}

const { id, route, method = 'GET' } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-titulo`} class="border-t border-line py-14 sm:py-20">
  <h2
    id={`${id}-titulo`}
    class="mb-8 flex items-baseline gap-2.5 font-mono text-xl font-semibold tracking-tight [font-stretch:112.5%] sm:text-2xl"
  >
    <span class="text-[0.7rem] font-medium tracking-normal text-accent [font-stretch:87.5%] sm:text-xs">{method}</span>
    <span>/{route}</span>
  </h2>
  <slot />
</section>
