---
import './diagrama.css';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = {
  pt: {
    title: 'Arquitetura do sistema de estoque',
    desc: 'O navegador acessa por HTTPS o Caddy, que repassa para a API Spring Boot. Os módulos de entrada e venda mudam o estoque só pelo EstoqueService, que grava no PostgreSQL. Tudo roda com Docker Compose num VPS, com backup diário fora do servidor.',
    browser: 'navegador',
    caddySub: 'proxy reverso + HTTPS automático',
    zone: 'docker compose (VPS)',
    chips: ['auth', 'catálogo', 'entrada', 'venda'],
    estoqueSub: 'extrato único, trava, custo médio',
    pgSub: 'migrações Flyway V1 a V3',
    backup: 'backup diário fora do servidor, 30 dias',
  },
  en: {
    title: 'Inventory system architecture',
    desc: 'The browser reaches Caddy over HTTPS, which forwards to the Spring Boot API. The stock-entry and sales modules change stock only through EstoqueService, which writes to PostgreSQL. Everything runs with Docker Compose on a VPS, with daily off-server backups.',
    browser: 'browser',
    caddySub: 'reverse proxy + automatic HTTPS',
    zone: 'docker compose (VPS)',
    chips: ['auth', 'catalog', 'stock-in', 'sales'],
    estoqueSub: 'single ledger, locking, avg cost',
    pgSub: 'Flyway migrations V1 to V3',
    backup: 'daily off-server backup, 30 days',
  },
}[lang];
const chipX = [46, 112, 178, 244];
---

<svg class="diagrama" viewBox="0 0 360 448" role="img" aria-labelledby="dg-estoque-t dg-estoque-d">
  <title id="dg-estoque-t">{s.title}</title>
  <desc id="dg-estoque-d">{s.desc}</desc>
  <defs>
    <marker id="dg-estoque-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
      <path class="head" d="M0 0 8 4 0 8z"></path>
    </marker>
  </defs>

  <rect class="box" x="30" y="8" width="300" height="44" rx="6"></rect>
  <text class="t" x="46" y="27">{s.browser}</text>
  <text class="s" x="46" y="43">React 19 + TypeScript + Mantine</text>

  <path class="wire" d="M180 52v32" marker-end="url(#dg-estoque-arrow)"></path>
  <text class="lbl" x="190" y="72">HTTPS</text>

  <rect class="zone" x="14" y="90" width="332" height="292" rx="10"></rect>
  <text class="lbl" x="24" y="105">{s.zone}</text>

  <rect class="box" x="30" y="114" width="300" height="44" rx="6"></rect>
  <text class="t" x="46" y="133">Caddy</text>
  <text class="s" x="46" y="149">{s.caddySub}</text>

  <path class="wire" d="M180 158v22" marker-end="url(#dg-estoque-arrow)"></path>

  <rect class="box" x="30" y="182" width="300" height="126" rx="6"></rect>
  <text class="t" x="46" y="201">Spring Boot 4 (Java 21)</text>
  {
    s.chips.map((label, i) => (
      <>
        <rect class="box" x={chipX[i]} y="212" width="58" height="24" rx="4" />
        <text class="chip-t" x={chipX[i] + 29} y="228" text-anchor="middle">{label}</text>
      </>
    ))
  }
  <path class="wire" d="M207 236v16" marker-end="url(#dg-estoque-arrow)"></path>
  <path class="wire" d="M273 236v16" marker-end="url(#dg-estoque-arrow)"></path>
  <rect class="box-accent" x="46" y="254" width="268" height="42" rx="5"></rect>
  <text class="t" x="60" y="272">EstoqueService</text>
  <text class="s" x="60" y="287">{s.estoqueSub}</text>

  <path class="wire" d="M180 308v22" marker-end="url(#dg-estoque-arrow)"></path>
  <text class="lbl" x="190" y="323">JPA</text>

  <rect class="box" x="30" y="332" width="300" height="42" rx="6"></rect>
  <text class="t" x="46" y="350">PostgreSQL 17</text>
  <text class="s" x="46" y="365">{s.pgSub}</text>

  <path class="wire-dashed" d="M180 374v28" marker-end="url(#dg-estoque-arrow)"></path>
  <rect class="box" x="30" y="404" width="300" height="36" rx="6"></rect>
  <text class="s" x="46" y="426">{s.backup}</text>
</svg>
