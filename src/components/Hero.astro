---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
import CurlTerminal from './CurlTerminal.astro';
import { profile } from '../data/profile';
import { useTranslations, type Lang } from '../i18n/ui';
import type { Content } from '../data/content';

interface Props {
  lang: Lang;
  c: Content;
}

const { lang, c } = Astro.props;
const t = useTranslations(lang);
// Porta 8080: o padrão do Spring Boot.
const command = 'curl localhost:8080/api/julia';
---

<div id="top" class="grid items-center gap-10 py-14 sm:py-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-14">
  <div class="min-w-0">
    <Image
      src={avatar}
      alt={t('hero.photoAlt')}
      width={80}
      height={80}
      densities={[1, 2]}
      loading="eager"
      class="size-16 rounded-xl border border-line object-cover sm:size-20"
    />
    <h1 class="mt-6 font-mono text-[1.75rem] leading-[1.1] font-semibold tracking-tight [font-stretch:112.5%] sm:text-[2.4rem]">
      {profile.name}
    </h1>
    <p class="mt-2 font-mono text-sm text-accent [font-stretch:87.5%]">{c.headline}</p>
    <p class="mt-5 max-w-[48ch] text-muted">{c.intro}</p>

    <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3 text-[0.94rem]">
      <a
        href={profile.cv}
        download
        class="rounded-md bg-accent px-3.5 py-2 font-medium text-accent-ink no-underline hover:brightness-110"
      >
        {c.cvLabel}
      </a>
      <a href={profile.github} class="font-medium underline">GitHub</a>
      <a href={profile.linkedin} class="font-medium underline">LinkedIn</a>
    </div>
  </div>

  <CurlTerminal command={command} body={c.apiResponse} label={t('hero.terminalLabel')} />
</div>
